{
  "name": "android-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that gives AI assistants structured access to an Android codebase",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "android-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
